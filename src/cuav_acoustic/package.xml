<?xml version="1.0"?>
<package format="3">
  <name>cuav_acoustic</name>
  <version>0.0.1</version>
  <description>Acoustic DOA estimation node for the counter-UAV system.</description>

  <maintainer email="121627019+TheRobotSkier@users.noreply.github.com">ehb</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime depends -->
  <depend>rclpy</depend>
  <depend>cuav_interfaces</depend>

  <!-- System Python deps (Debian package names) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-jack-client</exec_depend>
  <exec_depend>python3-soundfile</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
